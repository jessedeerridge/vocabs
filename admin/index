<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Yuko Wordlog（学生管理）</title>
  <style>
    :root{--bg:#f6f7fb;--card:#fff;--text:#111827;--muted:#667085;--line:#d9dee8;--accent:#111827;--danger:#b42318}
    *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",sans-serif}
    header{position:sticky;top:0;z-index:5;background:rgba(246,247,251,.94);border-bottom:1px solid var(--line)}
    .wrap{max-width:1100px;margin:auto;padding:14px 16px}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.space{flex:1}
    h1{font-size:18px;margin:0} button,input{font:inherit} button{border:0;border-radius:11px;padding:10px 14px;background:var(--accent);color:#fff;font-weight:800;cursor:pointer}
    button.secondary{background:#fff;color:var(--text);border:1px solid var(--line)} button.active{background:#2563eb}
    main{max-width:1100px;margin:auto;padding:16px}.card{background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden}
    .cardHead{padding:14px;border-bottom:1px solid var(--line)}.cardBody{padding:14px}.muted{color:var(--muted);font-size:13px}
    .grades{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}.grades button{min-width:62px}
    .tableWrap{overflow:auto}table{width:100%;border-collapse:collapse;background:#fff}th,td{padding:10px;border:1px solid var(--line);text-align:center;white-space:nowrap}th{font-size:12px;color:var(--muted)}td.left{text-align:left}
    tr.student{cursor:pointer}tr.student:hover{background:#f8fafc}.pct{font-weight:900}.good{color:#16803a}.mid{color:#b54708}.bad{color:#b42318}
    dialog{width:min(850px,calc(100% - 24px));border:1px solid var(--line);border-radius:16px;padding:0}dialog::backdrop{background:rgba(0,0,0,.45)}
    .login{position:fixed;inset:0;z-index:20;background:rgba(0,0,0,.46);display:grid;place-items:center;padding:16px}.loginCard{width:min(460px,100%);background:#fff;border-radius:16px;padding:18px}
    label{display:block;font-size:13px;font-weight:800;margin:10px 0 5px}input{width:100%;padding:11px;border:1px solid var(--line);border-radius:10px}.error{color:var(--danger);min-height:20px}
    @media(max-width:600px){th,td{padding:8px 6px;font-size:12px}}
  </style>
</head>
<body>
  <header><div class="wrap row"><h1>Yuko Wordlog — 学生管理</h1><div class="space"></div><span id="authState" class="muted">未ログイン</span><button id="logout" class="secondary" hidden>ログアウト</button></div></header>
  <main>
    <div class="grades" id="grades" aria-label="学年"></div>
    <section class="card"><div class="cardHead row"><strong id="title">Ⅰ 学生一覧</strong><div class="space"></div><button id="reload" class="secondary">再読み込み</button></div>
      <div class="cardBody"><p class="muted">本体からFirebaseへ保存された各課のpre1・pre2達成度を表示します。学年・課・単語の構成は管理画面から変更できません。</p><div id="message" class="muted">ログインしてください。</div>
        <div class="tableWrap"><table><thead><tr id="studentHead"></tr></thead><tbody id="students"></tbody></table></div>
      </div>
    </section>
  </main>
  <dialog id="detail"><div class="cardHead row"><strong id="detailTitle">学生詳細</strong><div class="space"></div><button id="closeDetail" class="secondary">閉じる</button></div><div class="cardBody tableWrap"><table><thead><tr><th>課</th><th>pre1</th><th>pre2</th></tr></thead><tbody id="lessonRows"></tbody></table></div></dialog>
  <div class="login" id="login"><form class="loginCard" id="loginForm"><h2>教師ログイン</h2><label for="email">メールアドレス</label><input id="email" type="email" autocomplete="username" required><label for="password">パスワード</label><input id="password" type="password" autocomplete="current-password" required><p class="error" id="loginError"></p><button type="submit">ログイン</button></form></div>
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/9.23.0/firebase-app.js";
    import { getDatabase, ref, get } from "https://www.gstatic.com/firebasejs/9.23.0/firebase-database.js";
    import { getAuth, signInWithEmailAndPassword, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/9.23.0/firebase-auth.js";

    const firebaseConfig={apiKey:"AIzaSyDEwJejLA1DnsoXVbCx_wfo3nmPtw5mbeQ",authDomain:"class-files-c5fef.firebaseapp.com",databaseURL:"https://class-files-c5fef-default-rtdb.firebaseio.com",projectId:"class-files-c5fef",storageBucket:"class-files-c5fef.firebasestorage.app",messagingSenderId:"373131822812",appId:"1:373131822812:web:f8bb96f3bb9cfe51f2d619"};
    const app=initializeApp(firebaseConfig),db=getDatabase(app),auth=getAuth(app);
    const COURSE=Object.freeze({1:{label:"Ⅰ",lessons:["1","2","3","4","5","6","7"]},2:{label:"Ⅱ",lessons:["8","9","10","11","12","13","14","15"]},3:{label:"Ⅲ",lessons:["1","2","3","4","5","6","7"]},4:{label:"Ⅳ",lessons:["8","9","10","11","12","13","14","15"]}});
    const $=id=>document.getElementById(id); const ADMIN_EMAIL_KEY="yuko_wordlog_admin_email";
    const grades=$("grades"),title=$("title"),studentHead=$("studentHead"),students=$("students"),message=$("message"),detail=$("detail"),detailTitle=$("detailTitle"),lessonRows=$("lessonRows"),login=$("login"),loginForm=$("loginForm"),loginError=$("loginError"),email=$("email"),password=$("password"),logout=$("logout"),reload=$("reload"),closeDetail=$("closeDetail"),authState=$("authState");
    let selectedGrade=1; let studentsRoot={}; let bestRoot={};
    const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
    const pct=n=>Number.isFinite(Number(n))?`${Math.round(Number(n))}%`:"--";
    const pctClass=n=>!Number.isFinite(Number(n))?"":Number(n)>=80?"good":Number(n)>=40?"mid":"bad";
    function stagePct(studentKey,lesson,stage){const value=bestRoot?.[studentKey]?.[selectedGrade]?.[lesson]?.[stage]?.bestPct;return Number.isFinite(Number(value))?Number(value):null}
    function lessonPct(studentKey,lesson){const p1=stagePct(studentKey,lesson,"pre1"),p2=stagePct(studentKey,lesson,"pre2");if(p1===null&&p2===null)return null;return ((p1||0)+(p2||0))/2}
    function totalPct(studentKey){const values=COURSE[selectedGrade].lessons.map(l=>lessonPct(studentKey,l));return values.reduce((sum,n)=>sum+(n||0),0)/COURSE[selectedGrade].lessons.length}
    function renderGrades(){grades.innerHTML="";Object.entries(COURSE).forEach(([id,cfg])=>{const b=document.createElement("button");b.textContent=cfg.label;b.className=Number(id)===selectedGrade?"active":"";b.onclick=()=>{selectedGrade=Number(id);renderGrades();renderStudents()};grades.appendChild(b)})}
    function renderStudents(){title.textContent=`${COURSE[selectedGrade].label} 学生一覧`;students.innerHTML="";studentHead.innerHTML=`<th class="left">学生</th>${COURSE[selectedGrade].lessons.map(l=>`<th>${l}課</th>`).join("")}<th>総達成度</th>`;const list=Object.entries(studentsRoot).filter(([key,s])=>bestRoot?.[key]?.[selectedGrade]||Number(s?.lastGrade)===selectedGrade).sort((a,b)=>totalPct(b[0])-totalPct(a[0])||String(a[1]?.name||a[0]).localeCompare(String(b[1]?.name||b[0]),"ja"));
      for(const [key,s] of list){const lessonCells=COURSE[selectedGrade].lessons.map(l=>{const value=lessonPct(key,l);return `<td class="pct ${pctClass(value)}">${pct(value)}</td>`}).join("");const total=totalPct(key),tr=document.createElement("tr");tr.className="student";tr.innerHTML=`<td class="left">${esc(s?.name||key)}</td>${lessonCells}<td class="pct ${pctClass(total)}">${pct(total)}</td>`;tr.onclick=()=>showDetail(key,s);students.appendChild(tr)}
      message.textContent=list.length?`${list.length}人を表示しています。`:"この学年の学生データはありません。"}
    function showDetail(key,s){detailTitle.textContent=`${s?.name||key} / ${COURSE[selectedGrade].label}`;lessonRows.innerHTML="";for(const lesson of COURSE[selectedGrade].lessons){const p1=stagePct(key,lesson,"pre1"),p2=stagePct(key,lesson,"pre2");const tr=document.createElement("tr");tr.innerHTML=`<td>${lesson}</td><td class="pct ${pctClass(p1)}">${pct(p1)}</td><td class="pct ${pctClass(p2)}">${pct(p2)}</td>`;lessonRows.appendChild(tr)}detail.showModal()}
    async function loadStudents(){message.textContent="読み込み中…";try{const [studentsSnap,bestSnap]=await Promise.all([get(ref(db,"students")),get(ref(db,"bestProgress"))]);studentsRoot=studentsSnap.exists()?studentsSnap.val():{};bestRoot=bestSnap.exists()?bestSnap.val():{};renderStudents()}catch(e){message.textContent=`読み込み失敗: ${e.message}`}}
    email.value=localStorage.getItem(ADMIN_EMAIL_KEY)||"";
    loginForm.onsubmit=async e=>{e.preventDefault();loginError.textContent="";const loginName=email.value.trim();localStorage.setItem(ADMIN_EMAIL_KEY,loginName);try{await signInWithEmailAndPassword(auth,loginName,password.value)}catch(err){loginError.textContent="ログインできませんでした。"}};
    logout.onclick=()=>signOut(auth);reload.onclick=loadStudents;closeDetail.onclick=()=>detail.close();
    onAuthStateChanged(auth,user=>{login.style.display=user?"none":"grid";logout.hidden=!user;authState.textContent=user?user.email:"未ログイン";if(user)loadStudents();else{studentsRoot={};bestRoot={};renderStudents()}});
    renderGrades();renderStudents();
  </script>
</body>
</html>
