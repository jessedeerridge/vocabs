 function buildOwnedPlayersList(ownedRoot, studentsRoot){
    const list = [];
    if (!ownedRoot || typeof ownedRoot !== "object") return list;
    for (const [studentKey, groups] of Object.entries(ownedRoot)){
      if (!groups || typeof groups !== "object") continue;
      let count = 0;
      for (const items of Object.values(groups)){
        if (!items || typeof items !== "object") continue;
        count += Object.keys(items).length;
      }
      if (count <= 0) continue;
      const name = String(studentsRoot?.[studentKey]?.name || studentKey);
      list.push({ studentKey, name, count });
    }
    list.sort((a,b)=> a.name.localeCompare(b.name, "ja"));
    return list;
  }

