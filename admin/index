      }catch(e){
        setItemMsg("画像2の読込失敗", false);
        return;
      }
    }
    const classConfig = getItemClassConfig(itemClass);
    const needsTwo = Number(classConfig?.imageCount || 1) >= 2;
    if (needsTwo && !image2){
      setItemMsg("画像2が必要なクラスです。画像2を追加してください。", false);
