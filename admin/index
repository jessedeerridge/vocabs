<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Yuko Wordlog（教師管理）</title>

  <style>
    :root{
      /* ✅ 白ベース（見やすく） */
      --bg:#f6f7fb;
      --card:#ffffff;
      --card2:#ffffff;
      --text:#111827;
      --muted:rgba(17,24,39,.62);
      --line:rgba(17,24,39,.14);
      --accent:#22c55e;
      --danger:#ef4444;
      --warn:#f59e0b;

      --btn:#111827;
      --btnText:#ffffff;
      --shadow: 0 18px 50px rgba(0,0,0,.08);
      --r:16px;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
      background: var(--bg);
      color:var(--text);
    }
    a{color:inherit}
    header{
      position:sticky; top:0; z-index:50;
      backdrop-filter: blur(10px);
      background: rgba(246,247,251,.86);
      border-bottom:1px solid var(--line);
    }
    .wrap{max-width:1200px;margin:0 auto;padding:14px 16px}
    .row{display:flex; gap:12px; align-items:center; flex-wrap:wrap}
    .space{flex:1}
    h1{font-size:16px;margin:0;font-weight:950;letter-spacing:.2px}

    .pill{
      display:inline-flex; align-items:center; gap:8px;
      padding:8px 12px; border:1px solid var(--line);
      border-radius:999px; background: rgba(255,255,255,.8);
      color:var(--muted); font-weight:850; font-size:12px;
    }
    .pill b{color:var(--text)}

    .tabs{display:flex; gap:8px; flex-wrap:wrap;}
    .tab{
      padding:10px 12px; border-radius:999px;
      border:1px solid var(--line);
      background: rgba(255,255,255,.9);
      color: var(--muted);
      cursor:pointer; font-weight:950;
    }
    .tab.active{
      background: #111827;
      color:#fff;
      border-color: #111827;
    }

    main{max-width:1200px;margin:0 auto;padding:16px}

    .card{
      background: var(--card);
      border:1px solid var(--line);
      border-radius: var(--r);
      box-shadow: var(--shadow);
      overflow:hidden;
    }
    .cardHead{
      padding:14px 14px;
      display:flex; align-items:center; gap:10px; flex-wrap:wrap;
      border-bottom:1px solid var(--line);
      background: rgba(17,24,39,.02);
    }
    .cardHead h2{margin:0;font-size:14px;font-weight:950}
    .cardBody{padding:14px}

    .muted{color:var(--muted);font-size:12px;font-weight:800}

    .btn{
      border:0; cursor:pointer;
      background: var(--btn);
      color: var(--btnText);
      font-weight:950;
      padding:10px 12px;
      border-radius: 12px;
    }
    .btn.secondary{
      background: #fff;
      color: var(--text);
      border: 1px solid var(--line);
    }

    .btn.danger{
      background: rgba(239,68,68,.10);
      color: #b91c1c;
      border: 1px solid rgba(239,68,68,.30);
    }
    .btn:active{transform:scale(.99)}

    input,select,textarea{
      width:100%;
      padding:10px 12px;
      border-radius: 12px;
      border:1px solid var(--line);
      background: #fff;
      color: var(--text);
      outline:none;
      font-weight:850;
    }
    textarea{min-height:92px; resize:vertical}
    label{display:block; font-size:12px; font-weight:950; color:var(--muted); margin:0 0 6px}
    .formRow{display:grid; grid-template-columns: 1fr 1fr; gap:10px}
    @media (max-width: 700px){ .formRow{grid-template-columns:1fr;} }

    .hr{height:1px;background:var(--line);margin:12px 0}

    /* ✅ 学年ボタン */
    .gradeBtns{display:flex; gap:8px; flex-wrap:wrap}
    .gbtn{
      padding:10px 12px;
      border-radius:999px;
      border:1px solid var(--line);
      background:#fff;
      color:var(--text);
      font-weight:950;
      cursor:pointer;
      min-width:72px;
      text-align:center;
    }
    .gbtn.active{
      background:#111827;
      color:#fff;
      border-color:#111827;
    }

    /* ✅ 表は「枠」つける */
    table{
      width:100%;
      border-collapse:collapse;
      border:1px solid var(--line);
      background:#fff;
    }
    th,td{
      padding:10px 10px;
      border:1px solid var(--line);
      vertical-align:middle;
    }
    th{
      font-size:12px;
      color:var(--muted);
      font-weight:950;
      text-align:center;
      background: rgba(17,24,39,.03);
      white-space:nowrap;
    }
    td{
      font-size:13px;
      font-weight:850;
      text-align:center;
      white-space:nowrap;
    }
    td.left, th.left{text-align:left}
    .trBtn{cursor:pointer}
    .trBtn:hover{background: rgba(17,24,39,.02)}
    .right{text-align:right}
    .small{font-size:12px;color:var(--muted);font-weight:850}
    .mono{font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size:12px}

    .pct{font-weight:980}
    .pct.good{color: #16a34a}
    .pct.mid{color: #d97706}
    .pct.bad{color: #dc2626}

    .tag{
      display:inline-flex; align-items:center; gap:6px;
      padding:6px 10px; border-radius:999px;
      border:1px solid var(--line);
      background: #fff;
      font-size:12px; font-weight:950; color:var(--muted);
      white-space:nowrap;
    }

    /* modal */
    .back{
      position:fixed; inset:0; display:none; align-items:center; justify-content:center;
      background: rgba(0,0,0,.45); z-index:100;
      padding:16px;
    }
    .modal{
      width:min(980px, 100%);
      max-height: 88vh;
      overflow:auto;
      border-radius: 18px;
      border:1px solid var(--line);
      background: #fff;
      box-shadow: 0 24px 80px rgba(0,0,0,.22);
    }
    .modalHead{
      position:sticky; top:0; z-index:2;
      display:flex; gap:10px; align-items:center; flex-wrap:wrap;
      padding:14px;
      border-bottom:1px solid var(--line);
      background: rgba(246,247,251,.92);
      backdrop-filter: blur(10px);
    }
    .modalHead h3{margin:0;font-size:14px;font-weight:980}
    .modalBody{padding:14px}

    .notice{
      padding:10px 12px;
      border-radius: 14px;
      border:1px solid rgba(245,158,11,.30);
      background: rgba(245,158,11,.10);
      color: #92400e;
      font-weight:900;
      font-size:12px;
    }
    .okline{
      padding:10px 12px;
      border-radius: 14px;
      border:1px solid rgba(34,197,94,.26);
      background: rgba(34,197,94,.10);
      color: #14532d;
      font-weight:900;
      font-size:12px;
    }
    .badline{
      padding:10px 12px;
      border-radius: 14px;
      border:1px solid rgba(239,68,68,.26);
      background: rgba(239,68,68,.10);
      color: #7f1d1d;
      font-weight:900;
      font-size:12px;
    }

    /* login overlay */
    #loginBack{display:flex}
    .loginCard{
      width:min(520px, 100%);
      border-radius: 18px;
      border:1px solid var(--line);
      background: #fff;
      box-shadow: 0 24px 80px rgba(0,0,0,.22);
      overflow:hidden;
    }
    .loginHead{
      padding:16px;
      border-bottom:1px solid var(--line);
      background: rgba(17,24,39,.02);
    }
    .loginHead .t1{font-weight:980}
    .loginBody{padding:16px}
    .loginFoot{padding:16px;border-top:1px solid var(--line);display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}

    .itemGrid{
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    .charaSlotGrid{
      display:grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap:12px;
      margin-top:12px;
    }
    .charaSlotCard{
      border:1px solid var(--line);
      border-radius:14px;
      background:#fff;
      padding:10px;
      display:flex;
      flex-direction:column;
      gap:8px;
      align-items:center;
      text-align:center;
    }
    .charaSlotCard img{
      width:96px;
      height:96px;
      object-fit:contain;
      border-radius:12px;
      border:1px solid var(--line);
      background: rgba(17,24,39,.04);
    }
    .itemClassSelect{
      border-radius:999px;
      border:1px solid var(--line);
      background:#fff;
      font-size:13px;
      font-weight:900;
      color:var(--muted);
      padding:2px 6px;
      width:auto;
    }

   .itemPriceInput{
      width:80px;
      padding:4px 6px;
      border-radius:10px;
      border:1px solid var(--line);
      font-size:12px;
      font-weight:900;
      text-align:right;
    }

    .itemClassEditor{
      display:grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap:10px;
      align-items:end;
    }
    .itemClassEditor .row{
      grid-column: 1 / -1;
    }
    .itemClassTable{
      width:100%;
      border-collapse:collapse;
      border:1px solid var(--line);
      background:#fff;
      margin-top:10px;
    }
    .itemClassTable th,
    .itemClassTable td{
      border:1px solid var(--line);
      padding:8px 10px;
      font-size:12px;
      font-weight:900;
      text-align:left;
      vertical-align:top;
    }
    .itemClassTable th{
      background: rgba(17,24,39,.03);
      color:var(--muted);
      text-align:center;
      white-space:nowrap;
    }
    .itemClassTable td .muted{
      font-size:11px;
    }


  .itemClassExclusiveList{
      display:flex;
      flex-direction:column;
      gap:4px;
      max-height:160px;
      overflow:auto;
      border:1px solid var(--line);
      border-radius:12px;
      padding:8px;
      background:#fff;
    }
    .itemClassExclusiveList label{
      display:flex;
      align-items:center;
      gap:6px;
      font-size:12px;
      font-weight:900;
      color:var(--text);
      margin:0;
    }
    .itemClassExclusiveList input{
      width:auto;
      margin:0;
    }

    .itemClassActions{
      display:flex;
      gap:6px;
      flex-wrap:wrap;
      justify-content:center;
    }

    .thumbEditor{
      display:flex;
      flex-direction:column;
      gap:8px;
    }
    .thumbPreview{
      position:relative;
      border-radius:12px;
      border:1px solid var(--line);
      background: rgba(17,24,39,.04);
      overflow:hidden;
      min-height:160px;
      display:flex;
      align-items:center;
      justify-content:center;
    }
    .thumbPreview img{
      width:100%;
      height:auto;
      display:block;
    }
    .thumbCrop{
      position:absolute;
      border:2px solid #22c55e;
      width:120px;
      height:120px;
      cursor:grab;
      box-shadow:0 0 0 9999px rgba(0,0,0,.25);
      border-radius:8px;
    }
    .thumbCrop.is-dragging{
      cursor:grabbing;
    }
    .thumbResult{
      display:flex;
      align-items:center;
      gap:10px;
    }
    .thumbResult img{
      width:64px;
      height:64px;
      border-radius:12px;
      border:1px solid var(--line);
      object-fit:cover;
      background: rgba(17,24,39,.04);
    }


    .itemGroupCard{
      border:1px solid var(--line);
      border-radius:16px;
      background:#fff;
      box-shadow: var(--shadow);
      overflow:hidden;
    }
    .itemGroupCard[open] .itemGroupHead::after{
      transform: rotate(90deg);
    }
    .itemGroupHead{
      list-style:none;
      display:flex;
      align-items:center;
      gap:10px;
      padding:14px;
      cursor:pointer;
      background: #3b82f6;
      color:#fff;
    }
    .itemGroupHead::-webkit-details-marker{display:none}
    .itemGroupHead::after{
      content:"›";
      margin-left:auto;
      font-weight:900;
      color:rgba(255,255,255,.85);
      transform: rotate(0deg);
      transition: transform .2s ease;
    }
    .itemGroupHead .itemGroupMeta{
      color:rgba(255,255,255,.78);
    }
    .itemGroupHead h4{
      margin:0;
      font-size:15px;
      font-weight:900;
    }
    .itemGroupMeta{
      font-size:12px;
      font-weight:850;
      color:var(--muted);
    }
    .itemGroupBody{
      padding:12px 14px 14px;
      display:flex;
      flex-direction:column;

      gap:12px;
    }
  .itemGroupItems{
      display:flex;
      flex-direction:column;
      gap:8px;
    }
    .rewardSetting{
      border:1px solid var(--line);
      border-radius:12px;
      background:#fff;
      overflow:hidden;
    }
    .rewardSetting[open] .rewardSettingHead::after{
      transform: rotate(90deg);
    }
    .rewardSettingHead{
      list-style:none;
      display:flex;
      align-items:center;
      gap:10px;
      padding:12px 14px;
      cursor:pointer;
      background: #ec4899;
      color:#fff;
      font-weight:900;
    }
    .rewardSettingHead::-webkit-details-marker{display:none}
    .rewardSettingHead::after{
      content:"›";
      margin-left:auto;
      font-weight:900;
      color:rgba(255,255,255,.85);
      transform: rotate(0deg);
      transition: transform .2s ease;
    }
    .rewardSettingBody{
      padding:12px 14px 14px;
      display:flex;
      flex-direction:column;
      gap:10px;
    }
    .rewardList{
      display:flex;
      flex-direction:column;
      gap:4px;
      padding-left:0;
    }
    .rewardCheck{
      display:flex;
      align-items:center;
      gap:6px;
      font-size:12px;
      font-weight:850;
      margin:0;
      padding:2px 0;
    }
    .rewardCheck input{
      width:auto;
      margin:0;
    }

   .wordCatalog{
      display:flex;
      flex-direction:column;
      gap:12px;
    }
    .wordFold{
      border:1px solid var(--line);
      border-radius:12px;
      background:#fff;
      overflow:hidden;
    }
    .wordFold[open] .wordFoldHead::after{
      transform: rotate(90deg);
    }
    .wordFoldHead{
      list-style:none;
      display:flex;
      align-items:center;
      gap:10px;
      padding:10px 12px;
      cursor:pointer;
      background: rgba(17,24,39,.04);
      font-weight:900;
    }
    .wordFoldHead::-webkit-details-marker{display:none}
    .wordFoldHead::after{
      content:"›";
      margin-left:auto;
      font-weight:900;
      color:rgba(17,24,39,.65);
      transform: rotate(0deg);
      transition: transform .2s ease;
    }
    .wordFoldMeta{
      font-size:12px;
      font-weight:850;
      color:var(--muted);
    }
    .wordFoldBody{
      padding:10px 12px 12px;
      display:flex;
      flex-direction:column;
      gap:8px;
    }
    .wordFold.sub{
      border-radius:10px;
    }
    .wordFold.sub .wordFoldHead{
      background: rgba(17,24,39,.02);
      padding:8px 10px;
      font-size:12px;
    }
    .wordFold.sub .wordFoldBody{
      padding:8px 10px 10px;
    }
    .wordNested{
      padding-left:10px;
      display:flex;
      flex-direction:column;
      gap:8px;
    }
    .wordListItem{
      display:flex;
      align-items:center;
      gap:12px;
      border:1px solid var(--line);
      border-radius:10px;
      padding:8px 10px;
      background:#fff;
      flex-wrap:wrap;
    }
    .wordListMeta{
      display:flex;
      flex-direction:column;
      gap:2px;
    }
    .wordListTitle{
      font-weight:900;
      font-size:13px;
    }
    .wordListSub{
      font-size:12px;
      font-weight:800;
      color:var(--muted);
    }
    .wordListActions{
      margin-left:auto;
      display:flex;
      align-items:center;
      gap:6px;
      flex-wrap:wrap;
    }
    .btn.tiny{
      padding:6px 8px;
      font-size:11px;
      border-radius:10px;
    }
    .wordStageBtn{
      border:1px solid var(--line);
      background:#fff;
      color:var(--text);
      font-weight:900;
      font-size:11px;
      padding:4px 8px;
      border-radius:999px;
      cursor:pointer;
    }
    .wordStageBtn:hover{
      background: rgba(17,24,39,.04);
    }


    .itemAddRow{
      display:grid;
      gap:8px;
      grid-template-columns: repeat(3, minmax(160px, 1fr));
    }
    .itemAddRow .row{
      align-items:center;
      grid-column: 1 / -1;
    }

    .itemAddThumb{
      grid-column: 1 / -1;
    }

    .itemCard{
      border:1px solid var(--line);
      border-radius:14px;
      padding:10px;
      background:#fff;
      box-shadow: var(--shadow);
      display:flex;
      align-items:center;
      gap:8px;
    }
    .itemCard.is-disabled{
      opacity:.6;
      background: rgba(17,24,39,.02);
      text-decoration: line-through;
    }
    .itemImg{
      width:16px;
      height:16px;
      border-radius:4px;
      border:1px solid var(--line);
      background: rgba(17,24,39,.06);
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
      flex:0 0 16px;
      cursor:pointer;
    }
    .itemImg.is-add{
      border-style:dashed;
      background:#fff;
      color:var(--muted);
      font-weight:950;
      font-size:12px;
    }


    .itemImgGroup{
      display:flex;
      align-items:center;
      gap:6px;
    }

    .itemImg img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .itemName{
      font-size:13px;
      font-weight:900;
      text-align:left;
      word-break:break-word;
    }
    .itemActions{
      margin-left:auto;
      display:flex;
      align-items:center;
      gap:8px;
    }
    .itemToggle{
      display:flex;
      align-items:center;
      gap:6px;
      font-size:12px;
      font-weight:850;
      color:var(--muted);
      white-space:nowrap;
    }
    .itemToggle input{
      width:auto;
      margin:0;
    }
   /* ✅ 所持アイテム管理 */

    .ownedPlayers{
      display:flex;
      flex-direction:column;
      gap:8px;
      margin-top:10px;
    }
    .ownedPlayerRow{
      display:grid;
      grid-template-columns: minmax(120px, 180px) minmax(220px, 300px) 1fr;
      gap:10px;
      align-items:center;
      border:1px solid var(--line);
      border-radius:12px;
      padding:8px 10px;
      background:#fff;
    }
    @media (max-width: 900px){
      .ownedPlayerRow{grid-template-columns: 1fr;}
    }
    .ownedPlayerName{
      font-weight:950;
      font-size:13px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .ownedAddControls{
      display:flex;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
    }
    .ownedAddControls select{
      width: 120px;
      padding:4px 6px;
      font-size:12px;
      border-radius:8px;
    }
    .ownedAddControls .btn{
      padding:4px 8px;
      font-size:12px;
      border-radius:8px;
    }
    .ownedItemsGroup{
      margin-top:12px;
    }
    .ownedItemsStrip{
      display:flex;
      align-items:center;
      gap:6px;
      overflow-x:auto;
      padding:4px 2px;
    }
    .ownedItemChip{
      display:inline-flex;
      align-items:center;
      gap:6px;
      border:1px solid var(--line);
      border-radius:999px;
      padding:4px 8px;
      text-align:center;
      background:#fff;
      font-weight:850;
      cursor:pointer;
      white-space:nowrap;
    }
    .ownedItemChip:hover{
      background: rgba(17,24,39,.04);
    }
    .ownedItemChip img{
      width:16px;
      height:16px;
      object-fit:cover;
      border-radius:4px;
      border:1px solid var(--line);
      background: rgba(17,24,39,.06);
      flex:0 0 16px;
    }
  </style>
</head>

<body>
<header>
  <div class="wrap">
    <div class="row">
      <h1>Yuko Wordlog（教師管理）</h1>
      <span class="pill">DB: <b id="dbHost">-</b></span>
      <span class="pill">ログイン: <b id="who">未</b></span>
      <div class="space"></div>

      <div class="tabs" id="tabs" style="display:none">
        <button class="tab active" data-tab="students" type="button">学生管理</button>
        <button class="tab" data-tab="words" type="button">単語管理</button>
        <button class="tab" data-tab="items" type="button">アイテム管理</button>
        <button class="tab" data-tab="owned-items" type="button">アイテム所持</button>
      </div>

      <button class="btn secondary" id="btnReload" type="button" style="display:none">再読込</button>
      <button class="btn danger" id="btnLogout" type="button" style="display:none">ログアウト</button>
    </div>
  </div>
</header>

<main id="app" style="display:none">
  <!-- Students Tab -->
  <section id="tab_students">
        <div class="card" style="margin-bottom:14px">
      <div class="cardHead">
        <h2>学年ボタン表示設定</h2>
        <div class="space"></div>
        <button class="btn secondary" id="btnGradeSettingsReload" type="button">再読込</button>
        <button class="btn" id="btnGradeSettingsSave" type="button">保存</button>
      </div>
      <div class="cardBody">
        <div class="small" id="gradeSettingsMsg">学生ページ右下の学年ボタンのラベルと表示/非表示を設定します。</div>
        <div style="overflow:auto; margin-top:10px">
          <table>
            <thead>
              <tr>
                <th style="min-width:120px">学年ID</th>
