      const reader = new FileReader();
      reader.onload = ()=> resolve(reader.result);
      reader.onerror = ()=> reject(reader.error || new Error("file read error"));
      reader.readAsDataURL(file);
    });
  }

 function initThumbEditor(addWrap){
    const preview = addWrap.querySelector(".thumbPreview");
    const img = addWrap.querySelector(".thumbSource");
    const crop = addWrap.querySelector(".thumbCrop");
    const resultImg = addWrap.querySelector(".thumbResultImg");
    const urlInput = addWrap.querySelector(".itemAddThumbUrl") || addWrap.querySelector(".itemAddUrl");
    const fileInput = addWrap.querySelector(".itemAddThumbFile") || addWrap.querySelector(".itemAddFile");
    const state = {
      hasSource: false,
      cropX: 0,
      cropY: 0,
      cropSize: 120,
      listImage: "",
      lastSource: "",
      pendingSource: ""
    };
    if (!preview || !img || !crop || !resultImg){
      return {
        hasSource: ()=> false,
        getListImage: ()=> "",
        reset: ()=>{}
      };
    }

    preview.style.display = "none";
    resultImg.style.display = "none";

    function clamp(val, min, max){
      return Math.max(min, Math.min(max, val));
    }

    function updateCropStyles(){
      crop.style.width = `${state.cropSize}px`;
      crop.style.height = `${state.cropSize}px`;
      crop.style.left = `${state.cropX}px`;
      crop.style.top = `${state.cropY}px`;
    }

    function updateResultImage(){
      if (!state.hasSource) return;
      const rect = img.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const canvas = document.createElement("canvas");
      canvas.width = 160;
      canvas.height = 160;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      const scaleX = img.naturalWidth / rect.width;
      const scaleY = img.naturalHeight / rect.height;
      const sx = state.cropX * scaleX;
      const sy = state.cropY * scaleY;
      const sSize = state.cropSize * Math.max(scaleX, scaleY);
      try{
        ctx.drawImage(img, sx, sy, sSize, sSize, 0, 0, canvas.width, canvas.height);
        state.listImage = canvas.toDataURL("image/png");
        resultImg.src = state.listImage;
        resultImg.style.display = "";
      }catch(e){
        // CORS等で失敗したら、既存のサムがあれば維持する
        if (!state.listImage){
          resultImg.src = "";
          resultImg.style.display = "none";
        }
      }
    }

    function resetCropBox(){
      const rect = img.getBoundingClientRect();
      const size = clamp(Math.min(rect.width, rect.height) * 0.5, 80, 220);
      state.cropSize = size;
      state.cropX = Math.max(0, (rect.width - size) / 2);
      state.cropY = Math.max(0, (rect.height - size) / 2);
      updateCropStyles();
      updateResultImage();
    }

    let dragging = false;
    let startX = 0;
    let startY = 0;
    let startLeft = 0;
    let startTop = 0;

    function onPointerMove(e){
      if (!dragging) return;
      const rect = img.getBoundingClientRect();
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      const nextX = clamp(startLeft + dx, 0, rect.width - state.cropSize);
      const nextY = clamp(startTop + dy, 0, rect.height - state.cropSize);
      state.cropX = nextX;
      state.cropY = nextY;
      updateCropStyles();
      updateResultImage();
    }

    function onPointerUp(){
      if (!dragging) return;
      dragging = false;
      crop.classList.remove("is-dragging");
      window.removeEventListener("pointermove", onPointerMove);
      window.removeEventListener("pointerup", onPointerUp);
    }

    crop.addEventListener("pointerdown", (e)=>{
      if (!state.hasSource) return;
      dragging = true;
      crop.classList.add("is-dragging");
      startX = e.clientX;
      startY = e.clientY;
      startLeft = state.cropX;
      startTop = state.cropY;
      window.addEventListener("pointermove", onPointerMove);
      window.addEventListener("pointerup", onPointerUp);
    });

    function setPreviewSource(src){
      const next = String(src || "").trim();
      if (!next) return;
      state.hasSource = true;
      preview.style.display = "";
      state.pendingSource = next;

     if (/^https?:/i.test(next)){
        img.referrerPolicy = "no-referrer";
        img.crossOrigin = "anonymous";
      }else{
        img.removeAttribute("crossorigin");
        img.referrerPolicy = "";
      }
      img.src = next;
    }

    img.onload = ()=>{
      state.lastSource = state.pendingSource || img.src;
      resetCropBox();
    };
    img.onerror = ()=>{
      if (state.lastSource && state.lastSource !== img.src){
        img.src = state.lastSource;
        return;
      }
      state.hasSource = false;
      preview.style.display = "none";
      state.listImage = "";
      resultImg.src = "";
      resultImg.style.display = "none";
    };

    if (urlInput){
      const handler = ()=>{
        const value = String(urlInput.value || "").trim();
        if (value) setPreviewSource(value);
      };
      urlInput.addEventListener("input", handler);
      urlInput.addEventListener("change", handler);
      urlInput.addEventListener("blur", handler);
    }
    if (fileInput){
      fileInput.addEventListener("change", async ()=>{
        const file = fileInput.files?.[0];
        if (!file) return;
        try{
          const dataUrl = await readFileAsDataUrl(file);
          if (urlInput) urlInput.value = "";
          setPreviewSource(dataUrl);
        }catch(e){
          setItemMsg("画像読込失敗", false);
        }
      });
    }

    return {
      hasSource: ()=> state.hasSource,
      getListImage: ()=> state.listImage,
      getSource: ()=> state.lastSource || state.pendingSource || "",
      reset: ()=>{
        state.hasSource = false;
        state.listImage = "";
        state.lastSource = "";
        state.pendingSource = "";
        resultImg.src = "";
        resultImg.style.display = "none";
        preview.style.display = "none";
        img.src = "";
        if (urlInput) urlInput.value = "";
        if (fileInput) fileInput.value = "";
      }
    };
  }


