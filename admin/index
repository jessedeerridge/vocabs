  function parseLessonKeys(wordsGradeObj){
    if (!wordsGradeObj || typeof wordsGradeObj !== "object") return [];
    return Object.keys(wordsGradeObj).map(x=>String(x).trim()).filter(Boolean).sort((a,b)=>{
      const ax = parseFloat(a.replace(/[^\d.]/g,"")) || 9999;
      const bx = parseFloat(b.replace(/[^\d.]/g,"")) || 9999;
      return ax - bx;
    });
  }

  async function getWordsGradeCached(grade){
    grade = String(grade);
    if (_wordsCacheByGrade.has(grade)) return _wordsCacheByGrade.get(grade);
    const wg = await dbGet(P.wordsGrade(grade)) || {};
    _wordsCacheByGrade.set(grade, wg);
    return wg;
  }

  function stageStats(wordsGradeObj, progressGradeObj, lesson, stage){
    const wStage = (wordsGradeObj?.[lesson]?.[stage]) || {};
    const ids = (wStage && typeof wStage === "object") ? Object.keys(wStage) : [];
    const total = ids.length;

    const pStage = (progressGradeObj?.[lesson]?.[stage]) || {};
    let mastered = 0;
    for (const wid of ids){
      if (pStage?.[wid]?.mastered === true) mastered += 1;
    }
    const rate = total>0 ? clamp(mastered/total,0,1) : 0;
    return { total, mastered, rate };
  }

  function sumStageAllLessons(wordsGradeObj, progressGradeObj, lessons, stage){
    let total=0, mastered=0;
    for (const lesson of lessons){
      const s = stageStats(wordsGradeObj, progressGradeObj, lesson, stage);
      total += s.total;
      mastered += s.mastered;
    }
    const rate = total>0 ? clamp(mastered/total,0,1) : 0;
    return { total, mastered, rate };
  }

  // ✅ 追加：複数stage（例：pre1+pre2）を合算
  function sumStagesAllLessons(wordsGradeObj, progressGradeObj, lessons, stages){
    let total=0, mastered=0;
    for (const lesson of lessons){
      for (const st of stages){
        const s = stageStats(wordsGradeObj, progressGradeObj, lesson, st);
        total += s.total;
        mastered += s.mastered;
      }
    }
    const rate = total>0 ? clamp(mastered/total,0,1) : 0;
    return { total, mastered, rate };
  }

