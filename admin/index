          if (sObj && typeof sObj === "object" && Object.keys(sObj).length){
            list.push({
              grade,
              lesson,
              stage,
              label: `${grade}/${lesson}/${stage}`
            });
          }
        }
      }
    }
    list.sort((a,b)=>{
      if (a.grade !== b.grade) return Number(a.grade) - Number(b.grade);
      if (a.lesson !== b.lesson) return String(a.lesson).localeCompare(String(b.lesson), "ja");
      return String(a.stage).localeCompare(String(b.stage), "ja");
    });
