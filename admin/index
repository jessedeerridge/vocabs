  function entryGroupMap(entry){
    const map = new Map();
    if (!entry || typeof entry !== "object") return map;
    const keys = Array.isArray(entry.groupKeys)
      ? entry.groupKeys
      : (entry.groupKey ? [entry.groupKey] : []);
    const names = Array.isArray(entry.groupNames)
      ? entry.groupNames
      : (entry.groupName ? [entry.groupName] : []);
    keys.forEach((k, idx)=>{
      const key = String(k || "").trim();
      if (!key) return;
      const name = String(names[idx] || entry.groupName || key);
      map.set(key, name || key);
    });
    return map;
  }

