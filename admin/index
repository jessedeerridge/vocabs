    const parts = [`<option value="">${esc(placeholder)}</option>`];
    for (const name of options){
      const isSelected = name === selected ? " selected" : "";
      parts.push(`<option value="${esc(name)}"${isSelected}>${esc(name)}</option>`);
    }
    return parts.join("");
