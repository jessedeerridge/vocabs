  function normalizeCharaSlotList(raw){
    if (!raw || typeof raw !== "object") return [];
    const list = [];
    for (const [key, value] of Object.entries(raw)){
      const image = String(value?.image || "").trim();
      if (!key) continue;
      list.push({
        key,
        image,
        updatedAt: value?.updatedAt || value?.createdAt || 0
      });
    }
    list.sort((a,b)=> String(a.key).localeCompare(String(b.key), "ja"));
    return list;
  }
  function renderCharaSlotGrid(list){
    if (!charaSlotGrid) return;
    charaSlotGrid.innerHTML = "";
    if (!list.length){
      charaSlotGrid.innerHTML = `<div class="small">キャラ欄が未登録です。</div>`;
      return;
    }
    for (const slot of list){
      const card = document.createElement("div");
      card.className = "charaSlotCard";
      const img = document.createElement("img");
      if (slot.image) img.src = slot.image;
      img.alt = slot.key;

      img.title = "クリックで画像変更";
      img.style.cursor = "pointer";
      const imgInput = document.createElement("input");
      imgInput.type = "file";
      imgInput.accept = "image/*";
      imgInput.style.display = "none";
