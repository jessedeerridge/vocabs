  function buildWordDetailTable(wordsGradeObj, progressGradeObj, lesson){
    const wLesson = wordsGradeObj?.[lesson] || {};
    const pLesson = progressGradeObj?.[lesson] || {};

    const rows = [];
    for (const st of ["pre1","pre2","review"]){
      const wStage = wLesson?.[st] || {};
      const ids = (wStage && typeof wStage === "object") ? Object.keys(wStage) : [];
      const pStage = pLesson?.[st] || {};
      for (const wid of ids){
        const w = wStage?.[wid] || {};
        const p = pStage?.[wid] || {};
        const word = String(w.word||"");
        const meaning = String(w.meaning||"");
        const cc = Number(p.correctCount||0);
        const wc = Number(p.wrongCount||0);
        const mastered = (p.mastered===true);
        rows.push({ st, word, meaning, cc, wc, mastered, lastAt: Number(p.lastAt||0) });
      }
    }
    rows.sort((a,b)=> (b.lastAt||0) - (a.lastAt||0));

    if (rows.length === 0){
      return `<div class="notice">この課には単語がありません（または進捗がまだありません）。</div>`;
    }

    return `
      <div style="overflow:auto">
        <table>
          <thead>
            <tr>
              <th>stage</th>
              <th class="left">単語</th>
              <th class="left">正解</th>
              <th>正解数</th>
              <th>誤答数</th>
              <th>mastered</th>
              <th>最終</th>
            </tr>
          </thead>
          <tbody>
            ${rows.map(r=>`
              <tr>
                <td><span class="mono">${esc(r.st)}</span></td>
                <td class="left">${esc(r.word)}</td>
                <td class="left">${esc(r.meaning)}</td>
                <td>${r.cc}</td>
                <td>${r.wc}</td>
                <td>${r.mastered ? '<span class="pct good">true</span>' : '<span class="pct bad">false</span>'}</td>
                <td class="small">${esc(fmtTime(r.lastAt))}</td>
              </tr>
            `).join("")}
          </tbody>
        </table>
      </div>
    `;
  }

