  async function loadWordCatalog(){
    if (!wordCatalogMsg) return;
    wordCatalogMsg.textContent = "読み込み中…";
    const gradeData = new Map();

    for (let g=1; g<=MAX_GRADE; g++){
      let wg = {};
      try{
        wg = await getWordsGradeCached(String(g));
      }catch(e){
        wg = {};
      }
      const lessons = parseLessonKeys(wg);
      const lessonEntries = [];
      let gradeQuizCount = 0;
      let gradeWordCount = 0;

      for (const lesson of lessons){
        const lObj = wg?.[lesson] || {};
        const stageCounts = {};
        const quizzes = [];
        let lessonWords = 0;

        for (const stage of ["pre1","pre2","review"]){
          const ids = (lObj?.[stage] && typeof lObj[stage] === "object") ? Object.keys(lObj[stage]) : [];
          const count = ids.length;
          if (!count) continue;
          stageCounts[stage] = count;
          lessonWords += count;
          gradeWordCount += count;
          quizzes.push({ grade: String(g), lesson: String(lesson), stage, count });
          gradeQuizCount += 1;
        }

        lessonEntries.push({
          lesson: String(lesson),
          stageCounts,
          totalWords: lessonWords,
          quizzes
        });
      }

      gradeData.set(String(g), {
        lessonEntries,
        quizCount: gradeQuizCount,
        wordCount: gradeWordCount
      });
    }

    for (const data of gradeData.values()){
      data.lessonEntries.sort((a,b)=> String(a.lesson).localeCompare(String(b.lesson), "ja"));
      for (const entry of data.lessonEntries){
        entry.quizzes.sort((a,b)=> String(a.stage).localeCompare(String(b.stage), "ja"));
      }
    }


    _wordCatalogCache = { gradeData };
    renderWordGradeList();
    wordCatalogMsg.textContent = "読み込みOK";
  }

  async function ensureWordCatalogLoaded(force = false){
    if (!_wordCatalogLoadedOnce || force){
      await loadWordCatalog();
      _wordCatalogLoadedOnce = true;
      return;
    }
    renderWordGradeList();
  }

  function handleGradeChange(){
    updateAddPath();
  }

  wGradeSel.onchange = handleGradeChange;
  wLessonSel.oninput = updateAddPath;
  wStageSel.onchange = updateAddPath;
  updateAddPath();

  if (btnReloadWordCatalog){
    btnReloadWordCatalog.onclick = ()=>{
      _wordCatalogLoadedOnce = false;
      ensureWordCatalogLoaded(true).catch(()=>{
        if (wordCatalogMsg) wordCatalogMsg.textContent = "読み込み失敗（DBルール/ネット制限）";
      });
    };
  }



  // ========= ここから：区切り仕様（: ： ; ；）対応 =========
  const SEP_CHARS = new Set([",","，","、"]);
  const MARK_CHARS = new Set([":","：",";","；"]);

  function readQuotedChunk(text, index){
    if (text[index] !== "\"") return null;
    const end = text.indexOf("\"", index + 1);
    if (end === -1) return null;
    return { value: text.slice(index + 1, end), nextIndex: end };
  }

  function normalizeDelims(text){
    // 「区切りのカンマ」を統一したい場所だけで使用（例文部分には使わない）
    return String(text||"").replaceAll("，", ",").replaceAll("、", ",");
  }

  function uniqStrings(list){
    const out = [];
    const seen = new Set();
    for (const s of list){
      const v = String(s||"").trim();
      if (!v) continue;
      const k = v.toLowerCase();
      if (seen.has(k)) continue;
      seen.add(k);
      out.push(v);
    }
    return out;
  }

  function splitTextAndFurigana(raw){
    const s = String(raw||"").trim();
    if (!s) return { text:"", furigana:"" };
    const m = s.match(/^(.*?)[（(]([^（）()]+)[）)]\s*$/);
    if (!m) return { text:s, furigana:"" };
    const text = String(m[1]||"").trim();
    const furigana = String(m[2]||"").trim();
    return { text: text || s, furigana };
  }

  function normalizeWrongsAndFurigana(wrongs, rawMap={}){
    const map = (rawMap && typeof rawMap === "object") ? rawMap : {};
    const outWrongs = [];
    const outMap = {};
    for (const item of (Array.isArray(wrongs) ? wrongs : [])){
      const original = String(item||"").trim();
      if (!original) continue;
      const parsed = splitTextAndFurigana(original);
      const text = parsed.text;
      const furigana = parsed.furigana || String(map[original] || map[text] || "").trim();
      if (!text) continue;
      outWrongs.push(text);
      if (furigana) outMap[text] = furigana;
    }
    return { wrongs: uniqStrings(outWrongs), wrongFurigana: outMap };
  }

  // ✅ token内の「誤答:例文 / 誤答；例文」対応（DB互換用）
  function splitWrongAndExample(token){
    const t = String(token||"").trim();
    if (!t) return { wrong:"", example:"" };

    // 最初に見つかった : ： ; ； を採用
    let pos = -1;
    for (let i=0; i<t.length; i++){
      if (MARK_CHARS.has(t[i])) { pos = i; break; }
    }
    if (pos === -1){
      return { wrong: t, example: "" };
    }
    const wrong = t.slice(0, pos).trim();
    const example = t.slice(pos+1).trim();
    return { wrong, example };
  }

  // ✅ 誤答欄(input)を「wrongs + example」に分解
  //    - : ： ; ； を見つけたら「その後ろ全部」を例文として扱う（例文内の , 、 は分割しない）
  function parseWrongsAndExample(text){
    const s = String(text||"");
    let wrongs = [];
    let buf = "";
    let example = "";

    for (let i=0; i<s.length; i++){
      const ch = s[i];

      if (MARK_CHARS.has(ch)){
        const w = buf.trim();
        if (w) wrongs.push(w);
        example = s.slice(i+1).trim(); // 以降は全部例文（カンマが入ってもOK）
        buf = "";
        break;
      }

      if (ch === "\n" || ch === "\r" || SEP_CHARS.has(ch)){
        const w = buf.trim();
        if (w) wrongs.push(w);
        buf = "";
        continue;
      }

      buf += ch;
    }

    if (!example){
      const w = buf.trim();
      if (w) wrongs.push(w);
    }

    wrongs = uniqStrings(wrongs);
    return { wrongs, example: String(example||"").trim() };
  }

  // ✅ 既存DBデータ互換：wrongsに「誤答:例文 / 誤答；例文」が混ざっている場合は吸い出す
  function normalizeDbWrongsAndExample(wrongs, example){
    const arr = Array.isArray(wrongs) ? wrongs.map(x=>String(x||"").trim()).filter(Boolean) : [];
    const ex0 = String(example||"").trim();

    let outWrongs = [];
    let exs = [];
    for (const t of arr){
      const { wrong, example: ex } = splitWrongAndExample(t);
      if (wrong) outWrongs.push(wrong);
      if (ex) exs.push(ex);
    }
    outWrongs = uniqStrings(outWrongs);

    exs = uniqStrings(exs);
    const exFromWrongs = exs.join(" / ");
    const exFinal = ex0 || exFromWrongs; // DBのexampleがあれば優先
    return { wrongs: outWrongs, example: exFinal };
  }

  // ✅ DB保存用（example はある時だけ付与）
  function buildWordPayload(word, meaning, wrongs, example, meaningFurigana="", wrongFurigana={}){
    const payload = { word, meaning, wrongs };
    if (example) payload.example = example;
    const mf = String(meaningFurigana||"").trim();
    if (mf) payload.meaningFurigana = mf;
    const wf = (wrongFurigana && typeof wrongFurigana === "object") ? wrongFurigana : {};
    if (Object.keys(wf).length) payload.wrongFurigana = wf;
    return payload;
  }

  // ✅ 一括追加：1行の解析
  //    - 区切りは「,」「，」「、」
  //    - 例文マークは「:」「：」「;」「；」
  //    - 例文マークが出たら「その後ろ全部」を例文として扱う（例文内の , 、 は分割しない）
  function parseBulkLine(line){
    const s0 = String(line||"").trim();
    if (!s0) return { ok:false, reason:"空行", line };

    const s = s0; // 例文を壊したくないので置換しない
    let fields = [];
    let buf = "";
    let i = 0;

    // 1) word / meaning を取る（2個の区切りまで読む）
    while (i < s.length){
      const ch = s[i];

      if (ch === "\""){
        const quoted = readQuotedChunk(s, i);
        if (quoted){
          buf += quoted.value;
          i = quoted.nextIndex + 1;
          continue;
        }
      }

      if (SEP_CHARS.has(ch)){
        const token = buf.trim();
        if (token) fields.push(token);
        else fields.push("");
        buf = "";

        // 連続区切り・空白を飛ばす
        i++;
        while (i < s.length && (SEP_CHARS.has(s[i]) || s[i] === " " || s[i] === "\t")) i++;

        if (fields.length >= 2) break; // word と meaning を確定（meaningの後の区切りまで到達）
        continue;
      }

      buf += ch;
      i++;
    }

    if (fields.length < 2){
      // 途中で終わった（区切りが足りない）
      const token = buf.trim();
      if (token) fields.push(token);
    }

    if (fields.length < 2){
      return { ok:false, reason:"項目不足（問題、正解、誤答1、誤答2 が必要）", line };
    }

    const word = String(fields[0]||"").trim();
    const meaningParsed = splitTextAndFurigana(fields[1]);
    const meaning = meaningParsed.text;
    const meaningFurigana = meaningParsed.furigana;

    // 2) 残り（誤答〜）を解析（例文マークが来たら残り全部 example）
    let wrongs = [];
    let example = "";
    buf = "";

    // i は「meaningの後の区切り」の次の位置
    for (; i < s.length; i++){
      const ch = s[i];

      if (ch === "\""){
        const quoted = readQuotedChunk(s, i);
        if (quoted){
          buf += quoted.value;
          i = quoted.nextIndex;
          continue;
        }
      }

      if (MARK_CHARS.has(ch)){
        const w = buf.trim();
        if (w) wrongs.push(w);

        // ✅ 以降は全部例文（カンマが入ってもOK）
        example = s.slice(i+1).trim();
        buf = "";
        break;
      }

      if (SEP_CHARS.has(ch)){
        const w = buf.trim();
        if (w) wrongs.push(w);
        buf = "";
        continue;
      }

      buf += ch;
    }

    if (!example){
      const w = buf.trim();
      if (w) wrongs.push(w);
    }

    const wrongNorm = normalizeWrongsAndFurigana(wrongs);
    wrongs = wrongNorm.wrongs;
    const wrongFurigana = wrongNorm.wrongFurigana;

    // 正解と同じ誤答を除外
    wrongs = wrongs.filter(w => w.toLowerCase() !== String(meaning||"").toLowerCase());

    if (!word || !meaning || wrongs.length < 1){
      return { ok:false, reason:"問題/正解/誤答(1個以上) が必要", line };
    }

    return { ok:true, word, meaning, meaningFurigana, wrongs, wrongFurigana, example, line };
  }
  // ========= ここまで：区切り仕様対応 =========

  function parseBulkText(text){
    const lines = String(text||"").split(/\r?\n/);
    const ok = [];
    const bad = [];
    lines.forEach((ln, idx)=>{
      const t = ln.trim();
      if (!t) return;
      const r = parseBulkLine(t);
      if (r.ok) ok.push({ ...r, idx: idx+1 });
      else bad.push({ ...r, idx: idx+1 });
    });
    return { ok, bad };
  }

  function setBulkMsg(s, ok=true){
    bulkMsg.textContent = s;
    bulkMsg.className = ok ? "okline" : "badline";
  }

  function renderBulkPreview(parsed){
    const { ok, bad } = parsed;
    const parts = [];

    if (ok.length){
      parts.push(`
        <div class="okline">OK：${ok.length} 件</div>
        <div style="overflow:auto;margin-top:10px">
          <table>
            <thead>
              <tr>
                <th style="min-width:60px">行</th>
                <th class="left" style="min-width:180px">単語</th>
                <th class="left" style="min-width:220px">正解</th>
                <th class="left" style="min-width:160px">フリガナ</th>
                <th class="left" style="min-width:240px">誤選択肢</th>
                <th class="left" style="min-width:260px">例文</th>
              </tr>
            </thead>
            <tbody>
              ${ok.map(x=>`
                <tr>
                  <td class="mono">${x.idx}</td>
                  <td class="left">${esc(x.word)}</td>
                  <td class="left">${esc(x.meaning)}</td>
                  <td class="left">${esc(x.meaningFurigana || "")}</td>
                  <td class="left">${esc(x.wrongs.join(" / "))}</td>
                  <td class="left">${x.example ? esc(x.example) : '<span class="muted"></span>'}</td>
                </tr>
              `).join("")}
            </tbody>
          </table>
        </div>
      `);
    }else{
      parts.push(`<div class="notice">OKの行がありません（形式を確認して）</div>`);
    }

    if (bad.length){
      parts.push(`
        <div class="hr"></div>
        <div class="badline">NG：${bad.length} 件（この行は追加されません）</div>
        <div style="overflow:auto;margin-top:10px">
          <table>
            <thead>
              <tr>
                <th style="min-width:60px">行</th>
                <th class="left" style="min-width:220px">理由</th>
                <th class="left">内容</th>
              </tr>
            </thead>
            <tbody>
              ${bad.map(x=>`
                <tr>
                  <td class="mono">${x.idx}</td>
                  <td class="left">${esc(x.reason)}</td>
                  <td class="mono left">${esc(x.line)}</td>
                </tr>
              `).join("")}
            </tbody>
          </table>
        </div>
      `);
    }

    bulkPreview.innerHTML = parts.join("");
  }

  btnBulkPreview.onclick = ()=>{
    const p = currentWordsPath();
    if (!p){
      setBulkMsg("プレビューNG：課（lesson）を入力して", false);
      bulkPreview.innerHTML = "";
      return;
    }
    const parsed = parseBulkText(bulkAddText.value);
    if (!parsed.ok.length && !parsed.bad.length){
      setBulkMsg("何も入力されていません", false);
      bulkPreview.innerHTML = "";
      return;
    }
    setBulkMsg(`プレビュー作成：OK ${parsed.ok.length} / NG ${parsed.bad.length}`, true);
    renderBulkPreview(parsed);
  };

  btnBulkAdd.onclick = async ()=>{
    const p = currentWordsPath();
    if (!p){
      setBulkMsg("追加NG：課（lesson）を入力して", false);
      return;
    }
    const parsed = parseBulkText(bulkAddText.value);
    const ok = parsed.ok;
    const bad = parsed.bad;

    if (!ok.length){
      setBulkMsg("追加NG：追加できる行がありません（形式を確認して）", false);
      renderBulkPreview(parsed);
      return;
    }

    renderBulkPreview(parsed);

    const msg = `OK ${ok.length} 件を追加します。NG ${bad.length} 件は無視します。実行しますか？`;
    if (!confirm(msg)) return;

    setBulkMsg("一括追加中…", true);

    try{
      const patch = {};
      for (const row of ok){
        const key = push(ref(db, p)).key;
        patch[`${p}/${key}`] = buildWordPayload(row.word, row.meaning, row.wrongs, row.example, row.meaningFurigana, row.wrongFurigana);
      }
      await dbMultiUpdate(patch);

      setBulkMsg(`追加OK：${ok.length} 件（NG ${bad.length} 件）`, true);
      bulkAddText.value = "";
      try{ btnLoadWords.click(); }catch(e){}
      ensureWordCatalogLoaded(true).catch(()=>{});
    }catch(e){
      setBulkMsg("追加失敗（DBルール/ネット制限）", false);
    }
  };

  btnBulkClear.onclick = ()=>{
    bulkAddText.value = "";
    bulkPreview.innerHTML = "";
    bulkMsg.textContent = "";
    bulkMsg.className = "muted";
  };

  // ✅ 追加：課の単語リストを一括削除（確認コード 121212 必須）
  btnBulkDeleteWords.onclick = async ()=>{
    const p = currentWordsPath();
    wordsTbody.innerHTML = wordsTbody.innerHTML; // no-op（既存に影響しない）
    if (!p){
      wordsMsg.textContent = "一括削除NG：課（lesson）を入力してください";
      return;
    }

    const g = String(wGradeSel.value||"1").trim();
    const lesson = String(wLessonSel.value||"").trim();
    const st = String(wStageSel.value||"pre1").trim();

    const code = prompt("【危険】一括削除の確認コードを入力してください（121212）");
    if (code === null) return;

    if (String(code).trim() !== "121212"){
      wordsMsg.textContent = "確認コードが違います（削除中止）";
      return;
    }

    const msg1 = `【危険】以下を一括削除します（元に戻せません）\n\n${g}年 / 課：${lesson} / stage：${st}\n\n実行しますか？`;
    if (!confirm(msg1)) return;

    wordsMsg.textContent = "一括削除中…";
    try{
      await dbRemove(p);          // ✅ ノードごと削除
      wordsTbody.innerHTML = "";  // ✅ 表を空に
      wordsMsg.textContent = "一括削除OK：0 件";

      // ✅ 学年キャッシュを破棄（学生管理の集計に反映しやすくする）
      _wordsCacheByGrade.delete(String(g));
      if (Number(currentGrade) === Number(g)){
        try{ await refreshStudents(); }catch(e){}
      }
      ensureWordCatalogLoaded(true).catch(()=>{});
    }catch(e){
      wordsMsg.textContent = "一括削除失敗（DBルール/ネット制限）";
    }
  };

  btnLoadWords.onclick = async ()=>{
    const p = currentWordsPath();
    wordsTbody.innerHTML = "";
    if (!p){
      wordsMsg.textContent = "課（lesson）を入力してください";
      return;
    }
    wordsMsg.textContent = "読み込み中…";
    try{
      const obj = await dbGet(p) || {};
      const ids = (obj && typeof obj === "object") ? Object.keys(obj) : [];
      if (ids.length === 0){
        wordsMsg.textContent = "単語がありません（追加してください）";
        return;
      }
      wordsMsg.textContent = `単語：${ids.length} 件`;

      for (const id of ids){
        const w = obj[id] || {};
        const word = String(w.word||"");
        const meaningParsed = splitTextAndFurigana(String(w.meaning||""));
        const meaning = meaningParsed.text;
        const meaningFurigana = String(w.meaningFurigana || meaningParsed.furigana || "").trim();
        const wrongs0 = Array.isArray(w.wrongs) ? w.wrongs : [];
        const example0 = String(w.example||"").trim();
        const wrongFurigana0 = (w.wrongFurigana && typeof w.wrongFurigana === "object") ? w.wrongFurigana : {};

        // ✅ 互換：wrongsに「誤答:例文 / 誤答；例文」が混在していたら吸い出す
        const norm = normalizeDbWrongsAndExample(wrongs0, example0);
        const wrongNorm = normalizeWrongsAndFurigana(norm.wrongs, wrongFurigana0);
        const wrongs = wrongNorm.wrongs;
        const example = norm.example;

        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td class="left"><input data-k="word" value="${esc(word)}"></td>
          <td class="left"><input data-k="meaning" value="${esc(meaning)}"></td>
          <td class="left"><input data-k="meaningFurigana" value="${esc(meaningFurigana)}" placeholder="（任意）"></td>
          <td class="left"><input data-k="wrongs" value="${esc(wrongs.join(", "))}"></td>
          <td class="left"><input data-k="example" value="${esc(example)}" placeholder="（任意）"></td>
          <td>
            <button class="btn secondary" data-act="save" type="button">保存</button>
            <button class="btn danger" data-act="del" type="button">削除</button>
          </td>
        `;

        tr.querySelector('button[data-act="save"]').onclick = async ()=>{
          const w2 = tr.querySelector('input[data-k="word"]').value.trim();
          const meaningRaw = tr.querySelector('input[data-k="meaning"]').value.trim();
          const mp = splitTextAndFurigana(meaningRaw);
          const m2 = mp.text;
          const mf2Input = tr.querySelector('input[data-k="meaningFurigana"]').value.trim();
          const mf2 = mf2Input || mp.furigana;

          // ✅ wrongs欄に「誤答:例文 / 誤答；例文」を入れても動く
          //    （マーク後はカンマが入っても例文扱い）
          const parsed = parseWrongsAndExample(tr.querySelector('input[data-k="wrongs"]').value);
          const wrongNorm2 = normalizeWrongsAndFurigana(parsed.wrongs);
          let ws = wrongNorm2.wrongs;

          // 例文は「例文欄」を優先（空なら誤答マークから拾う）
          const exInput = tr.querySelector('input[data-k="example"]').value.trim();
          const ex = exInput || parsed.example;

          // 正解と同じ誤答を除外
          ws = uniqStrings(ws.filter(x => String(x||"").toLowerCase() !== String(m2||"").toLowerCase()));

          if (!w2 || !m2 || ws.length < 1){
            wordsMsg.textContent = "保存NG：単語/正解 と 誤選択肢(1個以上) が必要（※正解と同じ誤答は除外）";
            return;
          }
          wordsMsg.textContent = "保存中…";
          try{
            await dbSet(p + "/" + id, buildWordPayload(w2, m2, ws, ex, mf2, wrongNorm2.wrongFurigana));
            wordsMsg.textContent = "保存OK";
          }catch(e){
            wordsMsg.textContent = "保存失敗（DBルール/ネット制限）";
          }
        };

        tr.querySelector('button[data-act="del"]').onclick = async ()=>{
          if (!confirm("削除しますか？（元に戻せません）")) return;
          wordsMsg.textContent = "削除中…";
          try{
            await dbRemove(p + "/" + id);
            tr.remove();
            wordsMsg.textContent = "削除OK";
            ensureWordCatalogLoaded(true).catch(()=>{});
          }catch(e){
            wordsMsg.textContent = "削除失敗（DBルール/ネット制限）";
          }
        };

        wordsTbody.appendChild(tr);
      }
    }catch(e){
      wordsMsg.textContent = "読み込み失敗（DBルール/ネット制限）";
    }
  };
</script>
